<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1732001705979-1" author="kandals">
        <createTable tableName="user">
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_user"/>
            </column>
            <column name="user_name" type="VARCHAR(255)"/>
            <column name="user_password" type="VARCHAR(255)"/>
            <column name="user_email" type="VARCHAR(255)"/>
            <column name="user_gender" type="VARCHAR(255)"/>
            <column name="user_birth_date" type="VARCHAR(255)"/>
            <column name="user_age" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1732001705979-2" author="kandals">
        <dropSequence sequenceName="authors_seq"/>
    </changeSet>
    <changeSet id="1732001705979-3" author="kandals">
        <dropSequence sequenceName="books_categories_seq"/>
    </changeSet>
    <changeSet id="1732001705979-4" author="kandals">
        <dropSequence sequenceName="books_publishers_seq"/>
    </changeSet>
    <changeSet id="1732001705979-5" author="kandals">
        <dropSequence sequenceName="books_seq"/>
    </changeSet>
    <changeSet id="1732001705979-6" author="kandals">
        <dropSequence sequenceName="categories_seq"/>
    </changeSet>
    <changeSet id="1732001705979-7" author="kandals">
        <dropSequence sequenceName="publishers_seq"/>
    </changeSet>
    <changeSet id="1732001705979-8" author="kandals">
        <dropSequence sequenceName="users_seq"/>
    </changeSet>

</databaseChangeLog>